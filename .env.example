# Used automatically by Docker Compose. Native PHP uses config/config.php or exported variables.
DB_NAME=istore
DB_USER=istore
DB_PASSWORD=change-this-local-demo-password
DB_ROOT_PASSWORD=change-this-local-root-password
APP_PORT=8080

# Optional AI assistant (Docker passes these to PHP; native PHP may use config/ai.php).
AI_ENABLED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_RATE_SECRET=

APP_SECRET=
AI_TIMEOUT_SECONDS=25
